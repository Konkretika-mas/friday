# OpenClaw Railway Template - Environment Variables
# Copy this file to .env for local development

# ==============================================================================
# REQUIRED CONFIGURATION
# ==============================================================================

# Setup wizard password - protects the /onboard endpoint
# Generate with: openssl rand -hex 24
SETUP_PASSWORD=your-secure-password-here

# ==============================================================================
# DATA PERSISTENCE (Recommended)
# ==============================================================================

# State directory for OpenClaw configuration, sessions, credentials
# On Railway, this should be within your mounted volume at /data
OPENCLAW_STATE_DIR=/data/.openclaw

# Workspace directory for file storage
OPENCLAW_WORKSPACE_DIR=/data/workspace

# ==============================================================================
# OPTIONAL CONFIGURATION
# ==============================================================================

# Gateway authentication token
# If not set, the wrapper server will auto-generate one and store it
# in $OPENCLAW_STATE_DIR/gateway.token
# OPENCLAW_GATEWAY_TOKEN=your-gateway-token

# Internal gateway port (default: 18789)
# This is the port OpenClaw gateway listens on internally
# INTERNAL_GATEWAY_PORT=18789

# ==============================================================================
# SECURITY CONFIGURATION
# ==============================================================================

# CRITICAL: Disable insecure auth on public domains (default: false — SECURE)
# When true, allows token-only auth to control-UI without device pairing.
# ONLY SAFE ON LOOPBACK (local/internal connections). On public domains, this is a CRITICAL SECURITY RISK.
# Set to true only if you need quick /lite access during initial setup, then disable immediately.
# Instructions: Use Railway Variables → Set ALLOW_INSECURE_AUTH=false to secure.
# ALLOW_INSECURE_AUTH=false

# ==============================================================================
# MEMORY & EMBEDDING CONFIGURATION
# ==============================================================================

# Memory backend type (default: builtin)
# builtin = local FTS (no external service)
# Options: qdrant, milvus, pinecone, etc. (requires external service)
# MEMORY_BACKEND=builtin

# Embedding provider for memory (optional)
# provider: openai (default), ollama, cohere, etc.
# Required if using vector memory backends (qdrant, milvus, pinecone, etc.)
# MEMORY_EMBEDDING_PROVIDER=openai

# Embedding provider API key (if required by the chosen provider)
# For OpenAI: starts with sk-
# MEMORY_EMBEDDING_KEY=sk-...

# ==============================================================================
# LOCAL DEVELOPMENT ONLY
# ==============================================================================

# Port for local development (Railway sets this automatically)
# PORT=8080
